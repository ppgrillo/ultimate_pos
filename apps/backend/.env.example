PORT=3001
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXTAUTH_SECRET=your-nextauth-secret
CORS_ORIGIN=http://localhost:3000

# Settings encryption key — used to encrypt sensitive store settings (MP tokens, etc.)
# at rest in the database. Can be any string. Falls back to NEXTAUTH_SECRET if not set.
SETTINGS_ENCRYPTION_KEY=your-encryption-key

# Public base URL of this backend — used to build the Clip PinPad webhook_url
# sent with every payment intent (Clip must be able to reach it from the internet).
# Example: https://api.yourdomain.com  (use an ngrok/localtunnel URL for local testing)
PUBLIC_API_URL=https://api.yourdomain.com
